---
# Template for vault.yml — copy, fill in real values, then encrypt:
#
#   cp inventory/group_vars/all/vault.yml.example inventory/group_vars/all/vault.yml
#   $EDITOR inventory/group_vars/all/vault.yml
#   ansible-vault encrypt inventory/group_vars/all/vault.yml
#
# After encryption, edit with:
#
#   make vault-edit          # or: ansible-vault edit inventory/group_vars/all/vault.yml
#
# vault.yml itself is gitignored — never commit decrypted secrets.

# --- SSH / sudo on every host (all OPTIONAL) ---
# Uncomment ONLY what your access model needs. A commented (undefined) key
# makes its connection var in vars.yml omit itself — so key-auth + NOPASSWD
# sudo needs NOTHING here. Never set these to "" (empty string != undefined).
#   • Key-based login, passwordless sudo → leave BOTH commented.
#   • Password login                     → set vault_ansible_password (needs sshpass).
#   • Sudo requires a password           → set vault_ansible_become_password.
# vault_ansible_user: "vastdata"                # only if the login user differs
# vault_ansible_password: "CHANGE_ME"           # SSH password login
# vault_ansible_become_password: "CHANGE_ME"    # sudo password

# --- VAST VMS auth for the CSI driver ---
# Credentials only. The tenant NAME (vms_tenant), VMS endpoint, VIP pool,
# view policy, and storage path are NOT secrets and live in
# inventory/group_vars/all/vars.yml under the "TENANT-SCOPED" block.
#
# For a CSI install inside a VAST tenant, use credentials of a user that
# (a) exists in the tenant (e.g. tenant-admin), and (b) has rights to
# create/mount file systems, VIP pools, and snapshots.
#
# Provide vault_vms_token OR both vault_vms_username + vault_vms_password.
vault_vms_token: ""
vault_vms_username: "CHANGE_ME"   # e.g. "ca-tenant-admin"
vault_vms_password: "CHANGE_ME"
